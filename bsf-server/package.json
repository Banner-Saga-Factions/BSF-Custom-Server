{
  "name": "bsf_server_tesing",
  "version": "0.0.1",
  "description": "ye",
  "main": "./build/index.js",
  "scripts": {
    "dev": "ts-node-dev --respawn src/index.ts",
    "build": "tsc -p ./",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:db": "vitest run --config vitest.config.db.ts",
    "test:coverage": "vitest run --coverage",
    "test:ci": "vitest run --reporter=verbose --coverage",
    "prepare": "simple-git-hooks"
  },
  "simple-git-hooks": {
    "pre-commit": "yarn build && yarn test"
  },
  "author": "Pieloaf",
  "license": "ISC",
  "dependencies": {
    "async-mqtt": "^2.6.3",
    "discord-api-types": "^0.37.61",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "express-rate-limit": "^8.5.1",
    "jsonwebtoken": "^9.0.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.14",
    "@types/jsonwebtoken": "^9.0.2",
    "@types/node": "^22.5.0",
    "@types/supertest": "^7.2.0",
    "@types/ws": "^8.5.3",
    "@vitest/coverage-v8": "^4.1.5",
    "discord-api-types": "^0.37.61",
    "simple-git-hooks": "^2.13.1",
    "supertest": "^7.2.2",
    "ts-node-dev": "^2.0.0",
    "tsc": "^2.0.4",
    "typescript": "^4.8.4",
    "vitest": "^4.1.5"
  },
  "engines": {
    "node": ">=24.0.0"
  }
}
