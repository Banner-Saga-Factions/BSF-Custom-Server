# SQLite database file path (relative to project root, or absolute).
# The server creates this file and its parent directory automatically on startup.
DB_PATH=./data/bsf.db

# Your public domain name — used by Caddy to obtain a TLS certificate from Let's Encrypt.
# Must match the DNS A record pointing at your server's IP.
BSF_DOMAIN=your.domain.here

# REQUIRED — server exits at startup if this is missing or empty
# Generate a random secret: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=replace-with-a-strong-random-secret

# Optional — only needed if enabling the Discord OAuth login path (~90% implemented, not yet production-ready)
DISCORD_CLIENT_ID=your_discord_app_client_id
DISCORD_CLIENT_SECRET=your_discord_app_client_secret
DISCORD_REDIRECT_URI=http://localhost:8082/login/discord/oauth-callback

# ---------------------------------------------------------------------------
# Matchmaking tuning (M2). Defaults match the original 2013 Stoic server's
# VsWorkerConfig and shouldn't need to change in practice. See
# misc/Plan-Integrate-Original-Stoic-Server.md milestone M2 for full context.
# ---------------------------------------------------------------------------

# How long (in seconds) it takes a queued player's power-tolerance window to
# grow from 0 (exact-power match only) to its maximum of 4 -- the same cap for
# every player. Growth is linear, so with the default 20 the window for a
# one-power gap opens after 5 seconds of waiting. In practice the pair forms
# nearer 10: the matcher runs every 5 seconds and tries to pair BEFORE it
# widens the window, so the first attempt after the window opens is the one
# that succeeds. Raise this to keep early matches closer in power; lower it to
# pair sooner.
#
# Deliberately shorter than the original 2013 server's 90: on a near-empty
# queue the longer ramp made people wait instead of play.
#VS_WINDOW_POWER_TIME_SECS=20

# Elo gap (in rating points) that counts as one "bracket" in the best-match
# scoring formula. The Java source comments this constant with "delta 200 in
# elo means a 75% chance to win" — that's the *intuition* behind the value,
# not what it gates. This constant does NOT widen or tighten which pairs are
# allowed to match (that's a separate internal threshold). It only influences
# which candidate is picked when SEVERAL queued players are already eligible:
# a lower bracket makes Elo differences weigh more heavily in the "closest
# match" score, so the matcher will prefer the smaller-Elo-gap candidate
# more strongly.
#VS_BRACKET_ELO=200

# Same idea as VS_BRACKET_ELO but for power gaps. Java source comment:
# "whatever power delta means 75% chance to win (empirical)." Also only
# affects the closest-match scoring, not admission.
#VS_BRACKET_POWER=4

# Instant rollback flag — when "true", the matchmaker reverts to the pre-M2
# exact-power scan and the 5-second pump becomes a no-op. Mirrors the
# BSF_RENOWN_LEGACY_FORMULA flag for renown awards.
#BSF_MATCHMAKER_LEGACY=false

# ---------------------------------------------------------------------------
# What a brand-new account starts with (#227)
# ---------------------------------------------------------------------------

# Renown is the game's spending money -- it hires units, promotes them, renames
# them and pays for barracks space. New accounts used to be created with none of
# it. That never stopped anyone hiring, because sixteen of the eighteen units on
# offer cost nothing, but it did mean a new player could not promote, rename or
# improve a single one of them until they had played several battles. They now
# start with 10000, which covers everything this server charges for across a
# completely full barracks, with change to spare.
#
# Set it to 0 to turn the grant off and get the old behaviour back. Anything else
# that is not a whole number between 0 and 2147483647 is ignored, with one warning
# in the log, and 10000 is used instead -- a typo here can never stop people
# signing in, and can never create an account the server is then unable to read.
#
# Only brand-new accounts are affected. An existing player's balance is never
# added to and never reset, however this is set.
#STARTING_RENOWN=10000

# ---------------------------------------------------------------------------
# Whether new accounts have to play the tutorial (#230)
# ---------------------------------------------------------------------------

# The game plays a scripted tutorial battle before it will let a first-time
# player do anything else. New accounts are now created as though they had
# already played it, so nobody is made to sit through it. Set this to false to
# hand the tutorial back to new players.
#
# Only brand-new accounts are affected. Somebody who already has an account keeps
# exactly where they had got to, however this is set -- it is read once, at the
# moment an account is created, and never again.
#
# Anything other than true, false, 1 or 0 is ignored, with one warning in the log,
# and the tutorial is skipped -- a typo here can never stop people signing in, and
# is never read as its opposite.
#
# This is not how you look at the tutorial as a developer. The game's own --tutorial
# launch flag is the nearest thing, and it does start regardless of what the server
# says -- but it enters at the tutorial's TOWN section. The scripted battle is only
# reached the ordinary way, so --tutorial will not show you the battle.
#SKIP_TUTORIAL=true

# ---------------------------------------------------------------------------
# Whether something of ours takes the traffic first and passes it on (#284)
# ---------------------------------------------------------------------------

# The standard deployment already sets this for you. docker-compose.yml puts the
# Caddy web server in front of the game server, and sets TRUST_PROXY=true in the
# same breath, because a setting there overrides anything written here. You only
# need this line by hand if you run the server yourself with your own proxy in
# front of it.
#
# What it is for: sign-ins are capped at five a minute from each network address.
# When something forwards traffic to us, every request arrives carrying the
# forwarder's address instead of the player's, so without this the cap counts
# everybody as one person -- and a restart, which signs everyone out at once,
# turns the sixth player away.
#
# Turn it on ONLY where a proxy you control takes the traffic first. The
# forwarded address is an ordinary header, which anything can write, so with
# nothing in front a player could choose which cap they are counted under and
# never run out. In particular, do NOT set this when running the image directly
# with a published port, as docs/Development.md describes.
#
# On means exactly ONE proxy, and that proxy is yours. true, false, 1 and 0 are
# the accepted spellings, and 1 and 0 mean on and off -- they are not a count.
# Anything else stops the server at startup with a message saying so, rather than
# being guessed at: a server that quietly fell back to off would look healthy
# while every player shared one cap.
#
# Left without a value on purpose. Uncommenting a line here would be the wrong
# move in the one deployment this warns about.
